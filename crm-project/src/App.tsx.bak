import { FormEvent, useMemo, useState } from "react";
import {
  BarChart3,
  Bell,
  BriefcaseBusiness,
  CalendarDays,
  Check,
  ChevronDown,
  CircleDollarSign,
  Download,
  FileBarChart,
  Filter,
  KanbanSquare,
  LayoutDashboard,
  ListTodo,
  Menu,
  MoreHorizontal,
  Plus,
  ReceiptText,
  Search,
  Settings,
  Target,
  Trash2,
  TrendingUp,
  UserRound,
  UsersRound,
  WalletCards,
  X,
} from "lucide-react";

type Page =
  | "Dashboard"
  | "Leads"
  | "Pipeline"
  | "Clientes"
  | "Projetos"
  | "Tarefas"
  | "Financeiro"
  | "Despesas"
  | "Relatórios"
  | "Configurações";
type Status =
  | "Novo"
  | "Primeiro contato"
  | "Em conversa"
  | "Interessado"
  | "Proposta enviada"
  | "Em negociação"
  | "Ganho"
  | "Perdido";
type Lead = {
  id: number;
  company: string;
  contact: string;
  email: string;
  segment: string;
  source: string;
  status: Status;
  owner: string;
  value: number;
  probability: number;
  next: string;
  date: string;
};
type Client = { id: number; leadId: number; company: string; contact: string; value: number };
type Project = {
  id: number;
  clientId: number;
  name: string;
  status: string;
  value: number;
  progress: number;
  deadline: string;
};
type Task = {
  id: number;
  title: string;
  relation: string;
  status: string;
  priority: string;
  due: string;
};
type Money = {
  id: number;
  name: string;
  value: number;
  status: string;
  kind: "receita" | "despesa";
  relation: string;
};

const brl = (n: number) =>
  new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
    maximumFractionDigits: 0,
  }).format(n);
const stages: Status[] = [
  "Novo",
  "Primeiro contato",
