generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMERCIAL
  FINANCEIRO
  OPERACIONAL
}

enum LeadStatus {
  NOVO
  PRIMEIRO_CONTATO
  EM_CONVERSA
  INTERESSADO
  PROPOSTA_ENVIADA
  EM_NEGOCIACAO
  GANHO
  PERDIDO
}

enum ProjectStatus {
  ORCAMENTO
  EM_DESENVOLVIMENTO
  EM_REVISAO
  ENTREGUE
  PAUSADO
  CANCELADO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum MoneyKind {
  RECEITA
  DESPESA
}

enum MoneyStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum FollowUpStatus { PENDENTE CONCLUIDO CANCELADO }
enum ProposalStatus { RASCUNHO ENVIADA NEGOCIACAO APROVADA RECUSADA EXPIRADA }

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COMERCIAL)
  active    Boolean  @default(true)
  authVersion Int    @default(0)
  totpSecret String?
  totpEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads     Lead[]    @relation("LeadOwner")
  tasks     Task[]    @relation("TaskAssignee")
  createdLeads Lead[] @relation("LeadCreator")
  financeEntries Finance[] @relation("FinanceResponsible")

  @@map("users")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model Lead {
  id          String     @id @default(cuid())
  company     String
  contact     String
  email       String?
  phone       String?
  segment     String?
  source      String?
  status      LeadStatus @default(NOVO)
  value       Decimal    @default(0) @db.Decimal(12, 2)
  probability Int        @default(0)
  nextAction  String?
  nextContact DateTime?
  notes       String?

  ownerId   String?
  owner     User?    @relation("LeadOwner", fields: [ownerId], references: [id])
  creatorId String?
  creator   User?    @relation("LeadCreator", fields: [creatorId], references: [id])

  client    Client?
  sale      ClosedSale?
  activities LeadActivity[]
  followUps FollowUp[]
  proposals Proposal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

model Client {
  id        String   @id @default(cuid())
  company   String
  contact   String
  email     String?
  phone     String?
  value     Decimal  @default(0) @db.Decimal(12, 2)
  notes     String?

  leadId    String?  @unique
  lead      Lead?    @relation(fields: [leadId], references: [id])

  projects  Project[]
  sales     ClosedSale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Project {
  id        String        @id @default(cuid())
  name      String
  status    ProjectStatus @default(ORCAMENTO)
  value     Decimal       @default(0) @db.Decimal(12, 2)
  progress  Int           @default(0)
  deadline  DateTime?
  notes     String?

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model Task {
  id        String       @id @default(cuid())
  title     String
  relation  String?      // texto livre (ex: "Lead Acme" ou "Projeto X")
  status    TaskStatus   @default(PENDENTE)
  priority  TaskPriority @default(MEDIA)
  dueDate   DateTime?
  notes     String?

  assigneeId String?
  assignee   User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model Finance {
  id        String      @id @default(cuid())
  name      String
  value     Decimal     @db.Decimal(12, 2)
  kind      MoneyKind
  status    MoneyStatus @default(PENDENTE)
  relation  String?     // texto livre (ex: "Projeto Acme" ou "Despesa operacional")
  dueDate   DateTime?
  paidAt    DateTime?
  category  String?
  notes     String?
  saleId    String?
  sale      ClosedSale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  idempotencyKey String? @unique
  responsibleId String?
  responsible User? @relation("FinanceResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finances")
}

model ClosedSale {
  id              String   @id @default(cuid())
  leadId          String   @unique
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contractAmount  Decimal  @db.Decimal(12, 2)
  previousStatus  LeadStatus?
  soldAt          DateTime @default(now())
  reversedAt      DateTime?
  reversalReason  String?
  reversedBy      String?
  payments        Finance[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([soldAt])
  @@index([reversedAt])
  @@map("closed_sales")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String
  type      String
  content   String
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model FollowUp {
  id          String @id @default(cuid())
  leadId      String
  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId     String
  description String
  dueAt       DateTime
  status      FollowUpStatus @default(PENDENTE)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId, status, dueAt])
  @@map("follow_ups")
}

model Proposal {
  id          String @id @default(cuid())
  leadId      String
  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  packageName String?
  description String
  items       Json
  discount    Decimal @default(0) @db.Decimal(12,2)
  total       Decimal @db.Decimal(12,2)
  terms       String?
  deadline    DateTime?
  status      ProposalStatus @default(RASCUNHO)
  version     Int @default(1)
  versions    ProposalVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([leadId, status])
  @@map("proposals")
}

model ProposalVersion {
  id         String @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json
  actorId    String
  createdAt  DateTime @default(now())
  @@unique([proposalId, version])
  @@map("proposal_versions")
}


model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
