# ===== Core =====
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173

# ===== Banco de dados =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# ===== Autenticação JWT =====
JWT_SECRET=troque-esta-chave-por-uma-muito-forte-e-aleatoria-com-pelo-menos-32-caracteres
# Opcional: chave independente para criptografar segredos do autenticador (mínimo 32 caracteres)
TOTP_ENCRYPTION_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=15m
BOOTSTRAP_ADMIN_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# ===== Segurança =====
BCRYPT_SALT_ROUNDS=12
