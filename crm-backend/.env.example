# ===== Core =====
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173

# ===== Banco de dados =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# ===== Autenticação JWT =====
JWT_SECRET=troque-esta-chave-por-uma-muito-forte-e-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# ===== Segurança =====
BCRYPT_SALT_ROUNDS=12

# ===== Primeiro administrador (usado só por `npm run prisma:seed`) =====
# Preencha, rode o seed uma vez e depois REMOVA ADMIN_PASSWORD daqui.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
